<Window x:Class="NetMusicTile.CalibrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调整面板位置"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        MinWidth="120" MinHeight="120">

    <Grid>
        <Border x:Name="Frame" CornerRadius="6" BorderThickness="2" BorderBrush="#FF4FC3F7"
                Background="#B30C1420" MouseLeftButtonDown="OnFrameDrag">
            <Grid Margin="8">

                <TextBlock Text="拖动这块 = 移动面板"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           FontSize="11" Foreground="#99FFFFFF"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPos" Text="0, 0"
                               HorizontalAlignment="Center" FontSize="19" FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="TxtSize" Text="0 × 0"
                               HorizontalAlignment="Center" FontSize="13" Margin="0,2,0,0"
                               Foreground="#CCFFFFFF"/>
                    <TextBlock Text="像素（物理）；方向键微调，Shift=10"
                               HorizontalAlignment="Center" FontSize="10" Margin="0,6,0,0"
                               Foreground="#80FFFFFF" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button Content="保存" Click="OnSave" Cursor="Hand"
                            Padding="14,4" Margin="0,0,6,0" FontSize="12"
                            Background="#FF4FC3F7" Foreground="#FF0B1220" BorderThickness="0"/>
                    <Button Content="取消" Click="OnCancel" Cursor="Hand"
                            Padding="14,4" FontSize="12"
                            Background="#33FFFFFF" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <Thumb x:Name="Grip" Width="20" Height="20"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" DragDelta="OnGripDrag">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#FF4FC3F7" CornerRadius="3">
                                <TextBlock Text="◢" FontSize="10" Foreground="#FF0B1220"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
